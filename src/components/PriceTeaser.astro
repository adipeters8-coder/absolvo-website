---
// Preis-Teaser „ab X € pro Hoodie“ mit Link in den Preisrechner
import preise from '../data/preise.json';
import { cent, formatEuro } from '../lib/preis';
import Button from './Button.astro';

interface Props {
  schulform?: 'abi' | 'realschule' | 'berufskolleg';
}
const { schulform } = Astro.props;
const guenstigste = [...preise.staffel_basis].sort((a, b) => a.preis - b.preis)[0];
const href = schulform ? `/preis-berechnen/?schulform=${schulform}` : '/preis-berechnen/';
---

<div class="teaser">
  <p class="teaser__ab">ab</p>
  <p class="teaser__preis">{formatEuro(cent(guenstigste.preis))}</p>
  <p class="teaser__einheit">pro Hoodie, ab {guenstigste.ab} Stück</p>
  <p class="teaser__hinweis">{preise.hinweis}</p>
  <Button href={href}>Preis berechnen</Button>
</div>

<style>
  .teaser {
    display: grid;
    justify-items: start;
    gap: 4px;
    padding: clamp(24px, 3vw, 36px);
    background: var(--papier);
    color: var(--tinte);
    border-radius: var(--radius);
  }

  .teaser__ab {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rot-text);
  }

  .teaser__preis {
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .teaser__einheit {
    font-weight: 700;
  }

  .teaser__hinweis {
    margin: 12px 0 20px;
    font-size: var(--fs-klein);
    color: var(--grau);
  }
</style>
