---
// Mobile Sticky-Leiste unten, auf allen Seiten außer dem Rechner
---

<div class="sticky-cta">
  <a href="/preis-berechnen/">Preis berechnen →</a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 30;
    padding: 10px var(--rand) calc(10px + env(safe-area-inset-bottom));
    background: var(--rot);
    border-top: 1px solid rgb(23 24 28 / 0.12);
  }

  .sticky-cta a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    color: var(--papier);
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .sticky-cta a:focus-visible {
    outline: 3px solid var(--tinte);
    outline-offset: 2px;
    border-radius: 999px;
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }

  /* Leiste fährt erst nach etwas Scrollen rein (ohne JS); ältere Browser zeigen sie sofort */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .sticky-cta {
        animation: sticky-rein linear both;
        animation-timeline: scroll(root);
        animation-range: 0 280px;
      }

      .sticky-cta:focus-within {
        animation: none;
      }
    }
  }

  @keyframes sticky-rein {
    from {
      transform: translateY(110%);
    }

    to {
      transform: translateY(0);
    }
  }
</style>

<style is:global>
  @media (max-width: 767.98px) {
    body.hat-sticky-cta {
      padding-bottom: calc(68px + env(safe-area-inset-bottom));
    }
  }
</style>
