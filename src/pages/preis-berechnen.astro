---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Preistabelle from '../components/Preistabelle.astro';
import Preisrechner from '../components/Preisrechner.astro';
import CtaBand from '../components/CtaBand.astro';
import preise from '../data/preise.json';
import { produkt } from '../lib/schema';
import { shy } from '../lib/text';

const description =
  'Was kostet euer Abschlusspullover? Menge, Farbe und Druck wählen, Preis pro Hoodie sofort sehen und unverbindlich anfragen.';
---

<Base
  title="Abschlusspullover Preis berechnen | ABSOLVO"
  description={description}
  jsonLd={[produkt(description)]}
  breadcrumb={[{ name: 'Preis berechnen', pfad: '/preis-berechnen/' }]}
>
  <section class="abschnitt abschnitt--rot rechner-hero" aria-labelledby="rechner-titel">
    <div class="container rechner-hero__innen">
      <SectionLabel text="Preisrechner" />
      <h1 id="rechner-titel">{shy('Was kostet euer Abschlusspullover?')}</h1>
      <p class="lead">
        Gebt ein, was ihr euch vorstellt. Der Preis passt sich sofort an. Danach schickt ihr die Anfrage unverbindlich ab und ich
        melde mich bei euch.
      </p>
    </div>
  </section>

  <section class="abschnitt abschnitt--papier-2 rechner-abschnitt" id="preisrechner" aria-label="Preisrechner und Anfrage">
    <div class="container">
      <Preisrechner />
    </div>
  </section>

  <section class="abschnitt abschnitt--papier" aria-labelledby="im-preis-titel">
    <div class="container im-preis">
      <div class="abschnitt__kopf">
        <SectionLabel text="Preise" />
        <h2 id="im-preis-titel">Was im Preis drin ist</h2>
        <p class="im-preis__text">
          Design und Druckvorbereitung, Druck vorne und hinten, Namensliste, Versand innerhalb Deutschlands.
        </p>
      </div>
      <div>
        <Preistabelle />
        <p class="im-preis__hinweis">{preise.hinweis}</p>
      </div>
    </div>
  </section>

  <CtaBand href="#preisrechner" />
</Base>

<style>
  .rechner-hero {
    padding-block: clamp(36px, 5vw, 72px);
  }

  .rechner-hero__innen {
    display: grid;
    gap: 20px;
  }

  .rechner-hero h1 {
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 6rem);
    max-width: 12em;
  }

  .rechner-abschnitt {
    padding-top: clamp(32px, 5vw, 64px);
  }

  /* ---------- Was im Preis drin ist ---------- */
  .im-preis__text {
    max-width: 30em;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.4;
  }

  .im-preis__hinweis {
    margin-top: 16px;
    font-size: var(--fs-klein);
    color: var(--tinte-2);
  }

  @media (min-width: 960px) {
    .im-preis {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
  }
</style>
