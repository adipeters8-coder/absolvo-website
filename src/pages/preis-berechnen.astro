---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Preistabelle from '../components/Preistabelle.astro';
import CtaBand from '../components/CtaBand.astro';
import preise from '../data/preise.json';
import farbwerte from '../data/farbwerte.json';
import site from '../data/site.json';
import { produkt } from '../lib/schema';
import { cent, formatEuro } from '../lib/preis';
import { shy } from '../lib/text';

const description =
  'Was kostet euer Abschlusspullover? Menge, Farbe und Druck wählen, Preis pro Hoodie sofort sehen und Anfrage direkt abschicken.';

// Formspree: Endpoint aus Umgebungsvariable, bis dahin Platzhalter (Absenden zeigt dann den Fehlerhinweis)
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const action = `https://formspree.io/f/${formspreeId || 'FORMSPREE_ID_FEHLT'}`;

const a = preise.aufpreise_pro_stueck;
const plus = (eur: number) => `+${formatEuro(cent(eur))}`;
const farbwert = (name: string) => (farbwerte as Record<string, string>)[name] ?? '#B5B2AB';
const reglerMax = Math.max(150, Math.max(...preise.staffel_basis.map((s) => s.ab)) + 50);
const startMenge = 30;

const schulformen = [
  { schluessel: 'abi', label: 'Abi/Fachabi' },
  { schluessel: 'realschule', label: 'Realschule/Hauptschule' },
  { schluessel: 'berufskolleg', label: 'Berufskolleg/Ausbildung' },
  { schluessel: 'sonstiges', label: 'Sonstiges' },
];
const druckVorne = [
  { wert: '1 Farbe', farben: 1, aufpreis: null },
  { wert: '2 Farben', farben: 2, aufpreis: plus(a.druck_vorne_2_farben) },
  { wert: '3 Farben oder mehr', farben: 3, aufpreis: plus(a.druck_vorne_3_farben) },
];
const ruecken = [
  { wert: 'Namensliste 1-farbig', farben: 1, aufpreis: null },
  { wert: 'Namensliste 2-farbig', farben: 2, aufpreis: plus(a.ruecken_2_farben) },
];
const mailHref = `mailto:${site.mail.adresse}?subject=${encodeURIComponent('Anfrage Abschlusspullover')}`;
---

<Base
  title="Abschlusspullover Preis berechnen | ABSOLVO"
  description={description}
  jsonLd={[produkt(description)]}
  breadcrumb={[{ name: 'Preis berechnen', pfad: '/preis-berechnen/' }]}
  stickyCta={false}
>
  <section class="abschnitt abschnitt--rot rechner-hero" aria-labelledby="rechner-titel">
    <div class="container rechner-hero__innen">
      <SectionLabel text="Preisrechner" />
      <h1 id="rechner-titel">{shy('Was kostet euer Abschlusspullover?')}</h1>
      <p class="lead">
        Gebt ein, was ihr euch vorstellt. Der Preis passt sich sofort an. Danach schickt ihr die Anfrage ab und ich
        melde mich bei euch.
      </p>
    </div>
  </section>

  <section class="abschnitt abschnitt--papier rechner-abschnitt" aria-label="Preisrechner und Anfrage">
    <div class="container">
      <form
        id="rechner"
        class="rechner"
        action={action}
        method="POST"
        data-formspree={formspreeId ? 'ja' : 'nein'}
      >
        <div class="rechner__konfig">
          <fieldset class="feld">
            <legend class="feld__titel">Schulform</legend>
            <div class="optionen optionen--raster">
              {
                schulformen.map((s, i) => (
                  <label class="option">
                    <input type="radio" name="schulform" value={s.label} data-schluessel={s.schluessel} checked={i === 0} />
                    <span class="option__text">{s.label.split('/').map((teil, j, alle) => (j < alle.length - 1 ? <Fragment>{teil}/<wbr /></Fragment> : teil))}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="feld">
            <label class="feld__titel" for="anzahl">Anzahl Hoodies</label>
            <div class="menge">
              <input
                class="menge__regler"
                type="range"
                id="anzahl-regler"
                min={preise.mindestmenge}
                max={reglerMax}
                step="1"
                value={startMenge}
                aria-label="Anzahl Hoodies, Regler"
                hidden
                data-regler
              />
              <input
                class="eingabe menge__zahl"
                type="number"
                id="anzahl"
                name="anzahl"
                min="1"
                max="2000"
                step="1"
                value={startMenge}
                inputmode="numeric"
                required
              />
            </div>
          </div>

          <div class="feld">
            <label class="feld__titel" for="uebergroessen">
              Davon Übergrößen 3XL bis 5XL <span class="feld__preis">{plus(a.uebergroesse_3xl_bis_5xl)} pro Stück</span>
            </label>
            <input
              class="eingabe eingabe--kurz"
              type="number"
              id="uebergroessen"
              name="uebergroessen"
              min="0"
              max={startMenge}
              step="1"
              value="0"
              inputmode="numeric"
            />
          </div>

          <fieldset class="feld">
            <legend class="feld__titel">Hoodie-Farbe</legend>
            <div class="farben">
              {
                preise.farben.map((farbe, i) => (
                  <label class="farbe">
                    <input type="radio" name="farbe" value={farbe} checked={i === 0} />
                    <span class="farbe__kachel" style={`--farbe: ${farbwert(farbe)}`} aria-hidden="true" />
                    <span class="farbe__name">{farbe}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="feld">
            <legend class="feld__titel">Druck vorne</legend>
            <div class="optionen">
              {
                druckVorne.map((o, i) => (
                  <label class="option">
                    <input type="radio" name="druck_vorne" value={o.wert} data-farben={o.farben} checked={i === 0} />
                    <span class="option__text">
                      {o.wert}
                      {o.aufpreis && <span class="option__preis">{o.aufpreis}</span>}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="feld">
            <legend class="feld__titel">Rücken</legend>
            <div class="optionen">
              {
                ruecken.map((o, i) => (
                  <label class="option">
                    <input type="radio" name="ruecken" value={o.wert} data-farben={o.farben} checked={i === 0} />
                    <span class="option__text">
                      {o.wert}
                      {o.aufpreis && <span class="option__preis">{o.aufpreis}</span>}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="feld">
            <legend class="feld__titel">Name auf dem Ärmel</legend>
            <div class="optionen">
              <label class="option">
                <input type="radio" name="aermelname" value="Ja" />
                <span class="option__text">Ja <span class="option__preis">{plus(a.aermelname)}</span></span>
              </label>
              <label class="option">
                <input type="radio" name="aermelname" value="Nein" checked />
                <span class="option__text">Nein</span>
              </label>
            </div>
          </fieldset>

          <div class="feld">
            <label class="feld__titel" for="rabattcode">Rabattcode <span class="feld__optional">(optional)</span></label>
            <input
              class="eingabe eingabe--code"
              type="text"
              id="rabattcode"
              name="rabattcode"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              aria-describedby="code-status"
            />
            <p class="code-status" id="code-status" aria-live="polite" data-code-status></p>
          </div>

          <div class="feld">
            <label class="feld__titel" for="wunschtermin">
              Wunschtermin Lieferung <span class="feld__optional">(optional)</span>
            </label>
            <input class="eingabe eingabe--kurz" type="date" id="wunschtermin" name="wunschtermin" />
          </div>
        </div>

        <aside class="rechner__ergebnis" aria-labelledby="ergebnis-titel">
          <div class="ergebnis">
            <p class="label" id="ergebnis-titel">Euer Preis</p>

            <div class="ergebnis__live" data-live hidden>
              <div data-preisblock>
                <p class="ergebnis__preis" data-ausgabe="pro-hoodie">–</p>
                <p class="ergebnis__einheit">pro Hoodie</p>
                <dl class="ergebnis__zeilen">
                  <div>
                    <dt>Gesamtpreis</dt>
                    <dd data-ausgabe="gesamt">–</dd>
                  </div>
                  <div data-zeile-ersparnis hidden>
                    <dt>Ersparnis durch Code</dt>
                    <dd class="ergebnis__ersparnis" data-ausgabe="ersparnis">–</dd>
                  </div>
                </dl>
              </div>
              <p class="ergebnis__mindest" data-mindest hidden>
                Ab {preise.mindestmenge} Hoodies geht's los. Kleinere Gruppe? Schreibt mir trotzdem.
              </p>
              <p class="ergebnis__anreiz" data-anreiz hidden></p>
            </div>

            <div class="ergebnis__statisch" data-statisch>
              <Preistabelle kompakt />
            </div>

            <p class="ergebnis__hinweis">{preise.hinweis}</p>
            <a class="btn ergebnis__cta" href="#kontakt">Zur Anfrage</a>
          </div>
          <p class="visually-hidden" aria-live="polite" data-ansage></p>
        </aside>

        <fieldset class="rechner__kontakt" id="kontakt">
          <legend><h2 class="kontakt__titel">Kontakt</h2></legend>
          <div class="kontakt__raster">
            <div class="feld">
              <label class="feld__titel" for="k-name">Name</label>
              <input class="eingabe" type="text" id="k-name" name="name" autocomplete="name" required />
            </div>
            <div class="feld">
              <label class="feld__titel" for="k-schule">Schule</label>
              <input class="eingabe" type="text" id="k-schule" name="schule" autocomplete="organization" required />
            </div>
            <div class="feld">
              <label class="feld__titel" for="k-ort">Ort</label>
              <input class="eingabe" type="text" id="k-ort" name="ort" autocomplete="address-level2" required />
            </div>
            <div class="feld">
              <label class="feld__titel" for="k-email">E-Mail</label>
              <input class="eingabe" type="email" id="k-email" name="email" autocomplete="email" required />
            </div>
            <div class="feld">
              <label class="feld__titel" for="k-telefon">Telefon <span class="feld__optional">(optional)</span></label>
              <input class="eingabe" type="tel" id="k-telefon" name="telefon" autocomplete="tel" />
            </div>
            <div class="feld kontakt__breit">
              <label class="feld__titel" for="k-nachricht">Nachricht <span class="feld__optional">(optional)</span></label>
              <textarea class="eingabe" id="k-nachricht" name="nachricht" rows="5"></textarea>
            </div>
          </div>

          <label class="einwilligung">
            <input type="checkbox" name="datenschutz" value="zugestimmt" required />
            <span>
              Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Mehr dazu in der
              <a href="/datenschutz/">{shy('Datenschutzerklärung')}</a>.
            </span>
          </label>

          <!-- Spamschutz (Honeypot) und berechnete Werte für Formspree -->
          <div class="honig" aria-hidden="true">
            <label>Dieses Feld bitte leer lassen <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="_subject" value="Neue Anfrage über absolvo.shop" data-betreff />
          <input type="hidden" name="_next" value="https://www.absolvo.shop/danke/" />
          <input type="hidden" name="preis_pro_hoodie" value="ohne JavaScript nicht berechnet" data-feld="pro-hoodie" />
          <input type="hidden" name="gesamtpreis" value="ohne JavaScript nicht berechnet" data-feld="gesamt" />
          <input type="hidden" name="staffelpreis_pro_stueck" value="ohne JavaScript nicht berechnet" data-feld="staffel" />
          <input type="hidden" name="ersparnis_code" value="0" data-feld="ersparnis" />

          <div class="absenden">
            <button class="btn" type="submit" data-absenden>Anfrage abschicken</button>
            <p class="fehler" role="alert" data-fehler hidden>
              Das hat leider nicht geklappt. Schreibt mir einfach direkt an <a href={mailHref}>{site.mail.anzeige}</a>.
            </p>
          </div>
        </fieldset>

        <div class="preisleiste" data-preisleiste hidden>
          <div class="preisleiste__text">
            <p data-leiste-preis><strong data-ausgabe="pro-hoodie">–</strong> pro Hoodie</p>
            <p class="preisleiste__gesamt" data-leiste-gesamt><span data-ausgabe="gesamt">–</span> gesamt</p>
            <p class="preisleiste__mindest" data-leiste-mindest hidden>Ab {preise.mindestmenge} Hoodies geht's los.</p>
          </div>
          <a class="btn preisleiste__btn" href="#kontakt">Zur Anfrage</a>
        </div>
      </form>
    </div>
  </section>

  <section class="abschnitt abschnitt--papier-2" aria-labelledby="im-preis-titel">
    <div class="container im-preis">
      <div class="abschnitt__kopf">
        <SectionLabel text="Preise" />
        <h2 id="im-preis-titel">Was im Preis drin ist</h2>
        <p class="im-preis__text">
          Design und Druckvorbereitung, Druck vorne und hinten, Namensliste, Versand innerhalb Deutschlands.
        </p>
      </div>
      <div>
        <Preistabelle />
        <p class="im-preis__hinweis">{preise.hinweis}</p>
      </div>
    </div>
  </section>

  <CtaBand href="#rechner" />
</Base>

<script>
  import '../scripts/konfigurator';
</script>

<style>
  .rechner-hero {
    padding-block: clamp(40px, 6vw, 80px);
  }

  .rechner-hero__innen {
    display: grid;
    gap: 24px;
  }

  .rechner-hero h1 {
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 6.5rem);
    max-width: 12em;
  }

  .rechner-abschnitt {
    padding-top: clamp(40px, 6vw, 80px);
  }

  /* ---------- Raster ---------- */
  .rechner {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 960px) {
    .rechner {
      grid-template-columns: minmax(0, 1fr) 380px;
      column-gap: clamp(40px, 5vw, 72px);
      row-gap: 64px;
    }

    .rechner__konfig {
      grid-column: 1;
      grid-row: 1;
    }

    .rechner__kontakt {
      grid-column: 1;
      grid-row: 2;
    }

    .rechner__ergebnis {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .ergebnis {
      position: sticky;
      top: 24px;
    }
  }

  /* ---------- Felder ---------- */
  fieldset {
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .feld + .feld {
    margin-top: 36px;
  }

  .feld__titel {
    display: block;
    margin-bottom: 12px;
    padding: 0;
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .feld__optional {
    font-weight: 500;
    color: var(--grau);
  }

  .feld__preis {
    display: inline-block;
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--grau);
  }

  .eingabe {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    background: #fff;
    border: 2px solid var(--grau);
    border-radius: 12px;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .eingabe:hover {
    border-color: var(--tinte);
  }

  .eingabe:focus-visible {
    outline: 3px solid var(--tinte);
    outline-offset: 2px;
    border-color: var(--tinte);
  }

  .eingabe--kurz {
    max-width: 220px;
  }

  .eingabe--code {
    max-width: 260px;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  textarea.eingabe {
    resize: vertical;
  }

  /* Optionen als Pillen */
  .optionen {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .optionen--raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 520px) {
    .optionen--raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .option {
    position: relative;
    display: flex;
    cursor: pointer;
  }

  .option input,
  .farbe input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .option__text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    width: 100%;
    min-height: 52px;
    padding: 13px 18px;
    background: var(--papier);
    border: 2px solid var(--grau);
    border-radius: 12px;
    font-weight: 700;
    line-height: 1.25;
    transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }

  .option:hover .option__text {
    border-color: var(--tinte);
  }

  .option input:checked + .option__text {
    background: var(--tinte);
    border-color: var(--tinte);
    color: var(--papier);
  }

  .option input:focus-visible + .option__text {
    outline: 3px solid var(--tinte);
    outline-offset: 3px;
  }

  .option__preis {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--grau);
  }

  .option input:checked + .option__text .option__preis {
    color: var(--papier-gedimmt);
  }

  /* Menge: Regler plus Zahl */
  .menge {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .menge__zahl {
    flex: none;
    width: 112px;
    font-family: var(--font-mono);
    font-weight: 500;
    text-align: center;
  }

  .menge__regler {
    flex: 1;
    min-width: 0;
    height: 44px;
    margin: 0;
    background: transparent;
    accent-color: var(--rot);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .menge__regler::-webkit-slider-runnable-track {
    height: 8px;
    background: linear-gradient(to right, var(--tinte) var(--fuellung, 10%), var(--linie) var(--fuellung, 10%));
    border-radius: 999px;
  }

  .menge__regler::-moz-range-track {
    height: 8px;
    background: var(--linie);
    border-radius: 999px;
  }

  .menge__regler::-moz-range-progress {
    height: 8px;
    background: var(--tinte);
    border-radius: 999px;
  }

  .menge__regler::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 30px;
    height: 30px;
    margin-top: -11px;
    background: var(--rot);
    border: 4px solid var(--papier);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--tinte);
  }

  .menge__regler::-moz-range-thumb {
    width: 22px;
    height: 22px;
    background: var(--rot);
    border: 4px solid var(--papier);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--tinte);
  }

  .menge__regler:focus-visible {
    outline: 3px solid var(--tinte);
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* Farbkacheln */
  .farben {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 8px;
  }

  @media (min-width: 600px) {
    .farben {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .farbe {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 6px 2px;
    text-align: center;
    cursor: pointer;
  }

  .farbe__kachel {
    width: 48px;
    height: 48px;
    background: var(--farbe);
    border: 2px solid var(--grau);
    border-radius: 50%;
    transition: box-shadow 0.12s ease;
  }

  .farbe__name {
    font-size: var(--fs-klein);
    font-weight: 500;
    line-height: 1.2;
  }

  .farbe:hover .farbe__kachel {
    box-shadow: 0 0 0 3px var(--papier), 0 0 0 5px var(--grau);
  }

  .farbe input:checked ~ .farbe__kachel {
    box-shadow: 0 0 0 3px var(--papier), 0 0 0 6px var(--tinte);
  }

  .farbe input:checked ~ .farbe__name {
    font-weight: 800;
  }

  .farbe input:focus-visible ~ .farbe__name {
    outline: 3px solid var(--tinte);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Code-Status */
  .code-status {
    min-height: 1.5em;
    margin-top: 8px;
    font-size: var(--fs-klein);
    font-weight: 700;
  }

  .code-status[data-zustand='gueltig'] {
    color: var(--rot-text);
  }

  .code-status[data-zustand='zu_wenig'],
  .code-status[data-zustand='unbekannt'] {
    color: var(--tinte-2);
  }

  /* ---------- Ergebnis ---------- */
  .ergebnis {
    --fokus: var(--papier);
    display: grid;
    gap: 16px;
    padding: clamp(24px, 3vw, 32px);
    background: var(--tinte);
    color: var(--papier);
    border-radius: var(--radius);
  }

  .ergebnis .label {
    color: var(--rot-auf-tinte);
  }

  .ergebnis__preis {
    font-size: clamp(3rem, 2.5rem + 2vw, 4.25rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .ergebnis__einheit {
    margin-top: 4px;
    font-weight: 700;
  }

  .ergebnis__zeilen {
    margin-top: 20px;
    border-top: 1px solid var(--tinte-2);
  }

  .ergebnis__zeilen > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--tinte-2);
  }

  .ergebnis__zeilen dt {
    color: var(--papier-gedimmt);
  }

  .ergebnis__zeilen dd {
    font-family: var(--font-mono);
    font-weight: 500;
    white-space: nowrap;
  }

  .ergebnis__ersparnis {
    color: var(--rot-auf-tinte);
  }

  .ergebnis__mindest {
