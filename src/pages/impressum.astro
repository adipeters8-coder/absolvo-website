---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';

const { inhaber } = site;
---

<Base
  title="Impressum | ABSOLVO"
  description="Impressum von ABSOLVO, Abschlusspullover aus Düsseldorf."
  breadcrumb={[{ name: 'Impressum', pfad: '/impressum/' }]}
>
  <PageHero label="Rechtliches" variante="papier">
    <Fragment slot="titel">Impressum</Fragment>
  </PageHero>

  <section class="abschnitt abschnitt--papier impressum" aria-label="Angaben">
    <div class="container prosa">
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        ABSOLVO<br />
        Inhaber: {inhaber.name}<br />
        {inhaber.strasse}<br />
        {inhaber.plz} {inhaber.ort}
      </p>

      <h2>Kontakt</h2>
      <p>E-Mail: <a href={`mailto:${site.mail.adresse}`}>{site.mail.anzeige}</a></p>

      <h2>Umsatzsteuer-ID</h2>
      <p>[USt-IdNr. nach § 27a UStG, falls vorhanden]</p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{inhaber.name}, {inhaber.strasse}, {inhaber.plz} {inhaber.ort}</p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>
        Ich bin nicht verpflichtet und nicht bereit, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
        teilzunehmen.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .impressum {
    padding-top: clamp(32px, 4vw, 56px);
  }
</style>
