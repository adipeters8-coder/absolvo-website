---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Rotstift from '../components/Rotstift.astro';
import FuerWen from '../components/FuerWen.astro';
import CtaBand from '../components/CtaBand.astro';
import TrustLeiste from '../components/TrustLeiste.astro';
import { produkt } from '../lib/schema';
import { shy } from '../lib/text';

const description =
  'Abipullover für Gymnasium, Gesamtschule und Fachabi. Mit Motto, Namensliste und fairem Preis. Jetzt Preis für euren Jahrgang berechnen.';
const merkmale = ['Motto vorne', 'Namensliste hinten', 'Name auf dem Ärmel', 'Eure Farbe'];
---

<Base
  title="Abipullover 2027 mit Motto und Namen | ABSOLVO"
  description={description}
  jsonLd={[produkt(description)]}
  breadcrumb={[{ name: 'Abipullover', pfad: '/abipullover/' }]}
>
  <PageHero label="Abi und Fachabi" buttons teaser>
    <Fragment slot="titel">
      {shy('Abipullover')} für euren <span class="nowrap">Jahrgang.<Rotstift typ="haken" farbe="tinte" animiert /></span>
    </Fragment>
    <p class="lead">
      Ob Gymnasium, Gesamtschule oder Fachoberschule: Euer Abipullover bekommt euer Motto vorne und alle Namen hinten. Ihr
      stimmt das Design mit mir ab, jeder trägt sich selbst ein und am Ende kommt ein Karton zu euch an die Schule.
    </p>
  </PageHero>

  <TrustLeiste />

  <section class="abschnitt abschnitt--papier" aria-labelledby="drauf-titel">
    <div class="container">
      <div class="abschnitt__kopf">
        <SectionLabel nummer="01" text="Druck" />
        <h2 id="drauf-titel">Was auf euren {shy('Abipullover')} <Rotstift typ="unterstreichung">kann</Rotstift></h2>
      </div>
      <ul role="list" class="merkmale">
        {
          merkmale.map((m, i) => (
            <li>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <span>{m}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="abschnitt abschnitt--tinte" aria-labelledby="motto-titel">
    <div class="container">
      <div class="abschnitt__kopf">
        <SectionLabel nummer="02" text="Motto" />
        <h2 id="motto-titel">Noch kein Abi-Motto?</h2>
      </div>
      <p class="lead">Schreibt mir eure Ideen, ich mache daraus ein Motiv.</p>
    </div>
  </section>

  <FuerWen nummer="03" ausser="/abipullover/" />

  <CtaBand />
</Base>

<style>
  .merkmale {
    display: grid;
    border-top: 1px solid var(--linie);
  }

  .merkmale li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--linie);
    font-size: var(--fs-h3);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  @media (min-width: 860px) {
    .merkmale {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }
</style>
