---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FuerWen from '../components/FuerWen.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Base
  title="Über ABSOLVO | Abschlusspullover aus Düsseldorf"
  description="Seit 2019 kümmert sich Adrian um Abschlusspullover für Klassen und Jahrgänge. ABSOLVO sitzt in Düsseldorf und lässt in Deutschland drucken."
  breadcrumb={[{ name: 'Über ABSOLVO', pfad: '/ueber-absolvo/' }]}
>
  <PageHero label="Über ABSOLVO" variante="papier">
    <Fragment slot="titel">Hi, ich bin Adrian.</Fragment>
    <p class="ueber__text">
      Seit 2019 kümmere ich mich immer wieder um die Abschlusspullover von Klassen und Jahrgängen. Dabei habe ich
      ziemlich viel gelernt, vor allem was gut läuft und was nicht. Mit ABSOLVO bekommt das Ganze jetzt einen festen
      Namen. ABSOLVO ist Latein und heißt so viel wie „ich schließe ab“. Ich sitze in Düsseldorf und lasse in
      Deutschland drucken.
    </p>
    <Fragment slot="aside">
      <!-- Platzhalter bis das Foto da ist: rund, schwarzweiß, roter Kringel -->
      <figure class="portrait">
        <div class="portrait__bild">
        <div class="portrait__kreis" role="img" aria-label="Platzhalter für ein Foto von Adrian">
          <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <circle cx="100" cy="78" r="36" fill="#9C9A95" />
            <path d="M34 200 C38 146 70 122 100 122 C130 122 162 146 166 200 Z" fill="#9C9A95" />
          </svg>
        </div>
        <svg class="portrait__kringel" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
          <path
            d="M 60 18 C 110 -2 182 22 190 88 C 198 150 150 192 96 190 C 40 188 6 146 10 96 C 14 52 46 22 104 12"
            fill="none"
            stroke="#E3262B"
            stroke-width="4"
            stroke-linecap="round"
          />
          <path
            d="M 48 30 C 100 4 176 32 186 96 C 192 156 140 196 90 194 C 34 190 2 150 8 90 C 14 46 60 16 120 16"
            fill="none"
            stroke="#E3262B"
            stroke-width="2.5"
            stroke-linecap="round"
            opacity="0.85"
          />
        </svg>
        </div>
        <figcaption class="portrait__hinweis">[Foto folgt]</figcaption>
      </figure>
    </Fragment>
  </PageHero>

  <FuerWen nummer="01" variante="papier-2" />

  <CtaBand />
</Base>

<style>
  .ueber__text {
    max-width: 34em;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.45;
  }

  .portrait {
    position: relative;
    width: min(100%, 360px);
    margin-inline: auto;
  }

  .portrait__bild {
    position: relative;
  }

  .portrait__kreis {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--papier-2);
    border-radius: 50%;
    filter: grayscale(1) contrast(1.2);
  }

  .portrait__kreis svg {
    width: 100%;
    height: 100%;
  }

  .portrait__kringel {
    position: absolute;
    inset: -7%;
    width: 114%;
    height: 114%;
    pointer-events: none;
  }

  .portrait__hinweis {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    text-align: center;
    color: var(--grau);
  }
</style>
