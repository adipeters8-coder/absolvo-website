---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
---

<Base
  title="Datenschutz | ABSOLVO"
  description="Datenschutzerklärung von ABSOLVO: Hosting, Anfrageformular und Schriften. Keine Cookies, kein Tracking."
  breadcrumb={[{ name: 'Datenschutz', pfad: '/datenschutz/' }]}
>
  <PageHero label="Rechtliches" variante="papier">
    <Fragment slot="titel">Datenschutz</Fragment>
  </PageHero>

  <!-- Platzhalter-Struktur: Rechtstext liefert Adrian -->
  <section class="abschnitt abschnitt--papier datenschutz" aria-label="Datenschutzerklärung">
    <div class="container prosa">
      <h2>Verantwortlicher</h2>
      <p>
        Adrian Peters<br />
        [Straße und Hausnummer]<br />
        [PLZ] Düsseldorf<br />
        E-Mail: <a href={`mailto:${site.mail.adresse}`}>{site.mail.anzeige}</a>
      </p>

      <h2>Hosting über GitHub Pages</h2>
      <p>
        Diese Website wird über GitHub Pages bereitgestellt (GitHub Inc., USA). Beim Aufruf der Seiten verarbeitet GitHub
        technisch notwendige Daten wie eure IP-Adresse.
      </p>
      <p>[Rechtsgrundlage, Speicherdauer der Server-Logs und Datenübermittlung in die USA ergänzen]</p>

      <h2>Anfrage über den Preisrechner (Formspree)</h2>
      <p>
        Wenn ihr eine Anfrage abschickt, werden eure Angaben aus dem Formular über den Dienst Formspree an mich
        übermittelt und zur Bearbeitung der Anfrage verwendet.
      </p>
      <p>[Anbieter, Rechtsgrundlage, Speicherdauer und Datenübermittlung in die USA ergänzen]</p>

      <h2>Schriften</h2>
      <p>
        Die Schriften dieser Website sind lokal eingebunden. Es wird keine Verbindung zu Google Fonts oder anderen
        Schriftanbietern aufgebaut.
      </p>

      <h2>Cookies und Tracking</h2>
      <p>Diese Website setzt keine Cookies und verwendet kein Tracking.</p>

      <h2>Links zu Instagram und TikTok</h2>
      <p>
        Die Links zu Instagram und TikTok sind einfache Links. Erst wenn ihr sie anklickt, werden Daten an den jeweiligen
        Anbieter übertragen.
      </p>

      <h2>Eure Rechte</h2>
      <p>
        [Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung, Widerspruch, Datenübertragbarkeit und
        Beschwerde bei einer Aufsichtsbehörde ergänzen]
      </p>

      <h2>Stand</h2>
      <p>[Datum]</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .datenschutz {
    padding-top: clamp(32px, 4vw, 56px);
  }
</style>
