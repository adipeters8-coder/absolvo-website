---
import '../styles/global.css';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import jetbrainsLatin500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolut, brotkrumen } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Pfad unterhalb von public/, z. B. /og/absolvo-og.png */
  ogBild?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Brotkrumen ohne Startseite; erzeugt BreadcrumbList */
  breadcrumb?: { name: string; pfad: string }[];
}

const {
  title,
  description,
  ogBild = '/og/absolvo-og.png',
  noindex = false,
  jsonLd = [],
  breadcrumb,
} = Astro.props;

const canonical = absolut(Astro.url.pathname);
const ogBildUrl = absolut(ogBild);
const schemas = breadcrumb ? [...jsonLd, brotkrumen(breadcrumb)] : jsonLd;

const fontFaces = `
@font-face{font-family:'Inter Tight Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interTightLatin}) format('woff2-variations'),url(${interTightLatin}) format('woff2');}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:500;src:url(${jetbrainsLatin500}) format('woff2');}
@font-face{font-family:'Inter Tight Fallback';src:local('Arial');size-adjust:96%;ascent-override:96%;descent-override:24%;line-gap-override:0%;}
`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F4F1EA" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="ABSOLVO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBildUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ABSOLVO: Abschlusspullover für jeden Abschluss." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogBildUrl} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
